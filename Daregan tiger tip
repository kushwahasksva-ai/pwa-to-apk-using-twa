      </div>
    )}

    <div className="text-[10px] text-zinc-500 mt-6 text-center">
      © {new Date().getFullYear()} DT Helper · सिर्फ़ एजुकेशनल/मनोरंजन हेतु
    </div>
  </div>
</div>

); }

