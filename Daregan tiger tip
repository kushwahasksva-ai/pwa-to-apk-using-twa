import React, { useEffect, useMemo, useRef, useState } from "react";

// फोन-फ्रेंडली, एक-पेज रिएक्ट ऐप (हिंदी UI) // यह ऐप कोई हैक या गारंटी नहीं देता — बस पिछले नतीजों (D/T/S) के आधार पर अनुमान देता है। // आप इसे मोबाइल ब्राउज़र में भी चला सकते हैं (PWA जैसा फील), या किसी भी React होस्ट पर।

// --- Types & constants const OUTCOMES = ["D", "T", "S"] as const; type Outcome = typeof OUTCOMES[number];

// --- Heuristic (सरल नियम-आधारित अनुमान) function analyzeNext(history: Outcome[], lookback: number) { const recent = history.slice(-lookback); const last = history[history.length - 1];

// टाई से पहले वाला non-S निकालें const prevNonS = [...history].reverse().find((x) => x !== "S");

// गिनती const counts = { D: 0, T: 0, S: 0 } as Record<Outcome, number>; for (const x of recent) counts[x]++;

// करंट स्ट्रीक (S को स्ट्रीक ब्रेकर नहीं मानते) let streakSide: Outcome | null = null; let streakLen = 0; for (let i = history.length - 1; i >= 0; i--) { const x = history[i]; if (x === "S") continue; if (!streakSide) { streakSide = x; streakLen = 1; } else if (x === streakSide) { streakLen++; } else break; }

// बारी-बारी (DTDT) का अनुपात let alternations = 0; for (let i = 1; i < recent.length; i++) { const a = recent[i - 1]; const b = recent[i]; if ((a === "D" || a === "T") && (b === "D" || b === "T") && a !== b) alternations++; } const alternationRatio = recent.length > 1 ? alternations / (recent.length - 1) : 0;

// बेस let suggestion: Outcome = "D"; let confidence = 52; // 51–88 के बीच क्लैम्प let reason = "बेसलाइन";

// Rule 1: अगर अभी S आया है, तो पहले वाला non-S लौटने का झुकाव if (last === "S" && prevNonS) { suggestion = prevNonS; confidence = Math.max(confidence, 60); reason = "Tie के बाद अक्सर पहले वाला साइड"; }

// Rule 2: 2+ की स्ट्रीक हो तो हल्का स्ट्रीक-राइड if (streakSide && (streakSide === "D" || streakSide === "T") && streakLen >= 2) { suggestion = streakSide; confidence = Math.max(confidence, 62 + Math.min(18, (streakLen - 2) * 7)); reason = स्ट्रीक चल रहा है (${streakSide} × ${streakLen}); }

// Rule 3: अगर alternation ज़्यादा (≥70%), तो फ्लिप if (alternationRatio >= 0.7 && (last === "D" || last === "T")) { suggestion = last === "D" ? "T" : "D"; confidence = Math.max(confidence, 63 + Math.round(alternationRatio * 15)); reason = "लगातार बारी-बारी पैटर्न"; }

// Rule 4: कोई मजबूत सिग्नल नहीं तो हाल की majority if (confidence < 62) { const maj = counts.D === counts.T ? (prevNonS ?? "D") : counts.D > counts.T ? "D" : "T"; suggestion = maj; confidence = Math.max(confidence, 58 + Math.abs(counts.D - counts.T) * 4); reason = "हाल की majority"; }

if (suggestion === "S") suggestion = prevNonS ?? "D"; // S प्रेडिक्ट नहीं करते confidence = Math.max(51, Math.min(88, Math.round(confidence)));

return { suggestion, confidence, reason, counts, streakSide, streakLen, alternationRatio }; }

const pretty = (x: Outcome) => (x === "D" ? "Dragon" : x === "T" ? "Tiger" : "Tie");

export default function DragonTigerHelper() { const [history, setHistory] = useState<Outcome[]>(() => { const saved = localStorage.getItem("dt_history"); return saved ? (JSON.parse(saved) as Outcome[]) : []; }); const [lookback, setLookback] = useState<number>(() => { const saved = localStorage.getItem("dt_lookback"); return saved ? Number(saved) : 6; }); const [hintOpen, setHintOpen] = useState(false);

useEffect(() => { localStorage.setItem("dt_history", JSON.stringify(history)); }, [history]); useEffect(() => { localStorage.setItem("dt_lookback", String(lookback)); }, [lookback]);

const stats = useMemo(() => analyzeNext(history, lookback), [history, lookback]);

const add = (o: Outcome) => setHistory((h) => [...h, o]); const undo = () => setHistory((h) => h.slice(0, -1)); const reset = () => setHistory([]);

// कीबोर्ड शॉर्टकट (D/T/S/Backspace) useEffect(() => { const onKey = (e: KeyboardEvent) => { const k = e.key.toLowerCase(); if (k === "d") add("D"); else if (k === "t") add("T"); else if (k === "s") add("S"); else if (k === "backspace") undo(); }; window.addEventListener("keydown", onKey); return () => window.removeEventListener("keydown", onKey); }, []);

return ( <div className="min-h-screen w-full bg-zinc-950 text-zinc-50 flex items-center justify-center p-4"> <div className="w-full max-w-md"> {/* Header */} <div className="mb-4"> <h1 className="text-2xl font-bold tracking-tight">Dragon–Tiger Pattern Helper</h1> <p className="text-xs text-zinc-400 mt-1"> यह ऐप पिछले रिज़ल्ट्स पर आधारित <span className="font-semibold">अनुमान</span> देता है — जीत की कोई गारंटी नहीं। </p> </div>

{/* Prediction Card */}
    <div className="rounded-2xl bg-zinc-900 border border-zinc-800 p-4 mb-4 shadow-xl">
      <div className="flex items-baseline justify-between">
        <div>
          <div className="text-sm text-zinc-400">अगला आने का अनुमान</div>
          <div className="text-3xl font-extrabold mt-1">
            {stats.suggestion === "D" ? (
              <span className="text-sky-400">Dragon (D)</span>
            ) : (
              <span className="text-red-400">Tiger (T)</span>
            )}
          </div>
        </div>
        <div className="text-right">
          <div className="text-sm text-zinc-400">Confidence</div>
          <div className="text-3xl font-extrabold mt-1">{stats.confidence}%</div>
        </div>
      </div>
      <div className="text-xs text-zinc-400 mt-2">कारण: {stats.reason}</div>
      <div className="mt-3">
        <div className="h-2 w-full bg-zinc-800 rounded-full overflow-hidden">
          <div
            className="h-full bg-zinc-200"
            style={{ width: `${stats.confidence}%` }}
          />
        </div>
      </div>
    </div>

    {/* Controls */}
    <div className="grid grid-cols-3 gap-3 mb-4">
      <button onClick={() => add("D")} className="rounded-2xl py-3 font-semibold bg-sky-500/20 border border-sky-500/40 active:scale-95">D</button>
      <button onClick={() => add("T")} className="rounded-2xl py-3 font-semibold bg-red-500/20 border border-red-500/40 active:scale-95">T</button>
      <button onClick={() => add("S")} className="rounded-2xl py-3 font-semibold bg-emerald-500/20 border border-emerald-500/40 active:scale-95">S</button>
    </div>

    <div className="flex items-center justify-between mb-2 text-sm">
      <span className="text-zinc-400">Lookback: <span className="font-semibold text-zinc-200">{lookback}</span></span>
      <div className="flex gap-2">
        <button onClick={undo} className="px-3 py-1.5 rounded-xl bg-zinc-800 border border-zinc-700 active:scale-95">Undo</button>
        <button onClick={reset} className="px-3 py-1.5 rounded-xl bg-zinc-800 border border-zinc-700 active:scale-95">Clear</button>
      </div>
    </div>
    <input
      type="range"
      min={3}
      max={12}
      value={lookback}
      onChange={(e) => setLookback(Number(e.target.value))}
      className="w-full mb-4"
    />

    {/* History pills */}
    <div className="rounded-2xl bg-zinc-900 border border-zinc-800 p-3 mb-4">
      <div className="text-sm text-zinc-300 mb-2">हिस्ट्री</div>
      {history.length === 0 ? (
        <div className="text-xs text-zinc-500">अभी खाली है — ऊपर D/T/S दबाइए।</div>
      ) : (
        <div className="flex flex-wrap gap-2">
          {history.map((x, i) => (
            <span
              key={i}
              className={
                "px-2.5 py-1 rounded-xl text-xs font-semibold border " +
                (x === "D"
                  ? "bg-sky-500/20 border-sky-500/40"
                  : x === "T"
                  ? "bg-red-500/20 border-red-500/40"
                  : "bg-emerald-500/20 border-emerald-500/40")
              }
            >
              {x}
            </span>
          ))}
        </div>
      )}
    </div>

    {/* Stats */}
    <div className="rounded-2xl bg-zinc-900 border border-zinc-800 p-3">
      <div className="grid grid-cols-3 text-center text-sm">
        <div>
          <div className="text-zinc-400">D (हाल)</div>
          <div className="font-bold text-sky-300">{history.slice(-lookback).filter((x) => x === "D").length}</div>
        </div>
        <div>
          <div className="text-zinc-400">T (हाल)</div>
          <div className="font-bold text-red-300">{history.slice(-lookback).filter((x) => x === "T").length}</div>
        </div>
        <div>
          <div className="text-zinc-400">Tie</div>
          <div className="font-bold text-emerald-300">{history.slice(-lookback).filter((x) => x === "S").length}</div>
        </div>
      </div>
      <div className="text-[11px] text-zinc-500 mt-2">
        स्ट्रीक: {stats.streakSide ? `${stats.streakSide} × ${stats.streakLen}` : "—"} · Alternation: {Math.round(stats.alternationRatio * 100)}%
      </div>
    </div>

    {/* Help */}
    <button onClick={() => setHintOpen((v) => !v)} className="mt-4 w-full rounded-2xl py-2 bg-zinc-800 border border-zinc-700 text-sm">
      {hintOpen ? "कम दिखाएँ" : "कैसे इस्तेमाल करें?"}
    </button>
    {hintOpen && (
      <div className="mt-3 text-xs text-zinc-300 space-y-2 border border-zinc-800 rounded-2xl p-3">
        <p><strong>D</strong> = Dragon, <strong>T</strong> = Tiger, <strong>S</strong> = Tie. हर राउंड का नतीजा जोड़ें।
        ऊपर दिख रहा अनुमान बस <em>पैटर्न-बेस्ड</em> है, गारंटी नहीं।</p>
        <ul className="list-disc pl-4 space-y-1">
          <li>Lookback बदलिए (3–12) — हाल की कितनी चालों पर फोकस हो।</li>
          <li>Undo से आख़िरी एंट्री हटाएँ, Clear से नई शुरुआत करें।</li>
